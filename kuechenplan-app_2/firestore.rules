rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur wer den langen Haushalts-Code kennt (20+ Zeichen) und angemeldet ist, kommt an die Daten.
    match /households/{hid}/{document=**} {
      allow read, write: if request.auth != null && hid.size() >= 20;
    }
  }
}
